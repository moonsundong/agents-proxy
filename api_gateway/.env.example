# LLM Agent Gateway 后端配置(环境变量前缀 GATEWAY_)
# 复制为 .env 后按需修改;所有敏感信息通过环境变量注入,禁止硬编码

# ---- 服务 ----
GATEWAY_DEBUG=false
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8300
GATEWAY_LOG_LEVEL=INFO

# ---- 数据库(开发默认 SQLite;生产可切 PostgreSQL)----
GATEWAY_DATABASE_URL=sqlite:///./gateway.db
# GATEWAY_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gateway

# ---- 前端跨域 ----
GATEWAY_CORS_ORIGINS=http://localhost:5188

# ---- 上游 LLM 调用 ----
GATEWAY_REQUEST_TIMEOUT=60.0

# ---- 决策模型(本地推理型模型评估慢,需要更长超时与更大输出预算)----
GATEWAY_DECISION_TIMEOUT=180.0
GATEWAY_DECISION_MAX_TOKENS=4096

# ---- 重试与熔断 ----
GATEWAY_LLM_MAX_RETRIES=2
GATEWAY_LLM_RETRY_BACKOFF=0.5
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
GATEWAY_CIRCUIT_COOLDOWN_SECONDS=30.0

# ---- HuggingFace 缓存(Headroom Kompress 模型权重下载位置)----
# 不设置则默认 ~/.cache/huggingface;Windows 下建议改到非系统盘,如 D:\hf-cache
# GATEWAY_HF_HOME=
